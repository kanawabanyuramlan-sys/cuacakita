# CuacaKita — contoh berkas environment
#
# Aplikasi ini BERJALAN PENUH TANPA SATU PUN variabel di bawah ini.
# Open-Meteo dan BMKG sama-sama tidak memerlukan kunci API, jadi tidak ada
# yang perlu disiapkan sebelum deploy ke Vercel.
#
# Berkas ini ada untuk mendokumentasikan opsi yang tersedia bila kelak
# sumber data berbayar ditambahkan.

# Mengganti lokasi bawaan saat pengguna belum memilih apa pun.
# Harus salah satu nama kota di src/data/wilayah.json.
# NEXT_PUBLIC_LOKASI_BAWAAN=Bandung

# Dicadangkan untuk sumber data harga komoditas, bila nanti terhubung.
# Simpul "Harga" saat ini TIDAK terhubung ke data pasar mana pun.
# HARGA_API_URL=
# HARGA_API_KEY=
